# AWS Rekognition
AWS_REGION=sa-east-1
REKOGNITION_COLLECTION_ID=your-collection-name

# Google Drive: IDs das pastas raiz de cada categoria a indexar.
# Formato livre -- adicione quantas categorias precisar.
DRIVE_ROOT_FOLDERS=Category A:your-folder-id-a,Category B:your-folder-id-b

# Google Sheets: planilha de controle (registro + regra de nao-repeticao)
TRACKING_SPREADSHEET_ID=your-spreadsheet-id
TRACKING_SHEET_NAME=Recognitions

# Caminhos locais de credenciais (nao versionar os arquivos em si)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
